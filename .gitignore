# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/tests/e2e/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# python
__pycache__/
*.pyc
*.pyo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local data (waitlist mock storage)
/data/

# vercel
.vercel
.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase local
supabase/.temp/

# local agent/workspace artifacts
/tmp/
.worktrees/
.claude/worktrees/
.superpowers/
.pytest_cache/
.ruff_cache/
# Studio: track source, ignore generated packs/PDFs (path case matters on Linux)
Reports/*
!Reports/studio/
Reports/studio/packs/
Reports/studio/out/*.pdf
Reports/studio/out/_superseded*/
