# Every variable the app reads. "Required" ones break the site or a core flow when
# missing; the rest have safe defaults. Set production values in Vercel →
# Settings → Environment Variables.

# ── Database (required) ──────────────────────────────────────────────────────
# Supabase Postgres connection string (pooler URL).
DATABASE_URL=
# Optional: max connections per server instance (default 5).
DATABASE_POOL_MAX=

# ── Agent pipeline (required in production) ──────────────────────────────────
# disabled   = create visible blocked run records only (the default when unset)
# agentic_v1 = run the TypeScript agent ledger/workers — production needs this
EXECUTION_BACKEND=disabled
# Authorizes the Vercel crons (/api/admin/agents/tick, /api/admin/crew/daily-brief).
CRON_SECRET=generate-a-random-token
# Optional: who receives the daily crew brief (default hello@bankfeeindex.com).
ATLAS_BRIEF_TO=
# Optional: earliest quarter the regulatory registry backfills (default 2010Q1).
REGISTRY_BACKFILL_FROM=

# ── Authentication (required) ────────────────────────────────────────────────
# Signs login sessions; login fails in production without it.
BFI_COOKIE_SECRET=generate-a-random-64-char-hex-string

# ── AI provider ──────────────────────────────────────────────────────────────
# Shared key. Hamilton features and the pipeline's paid last-pass steps use it
# unless the agent has its own key below.
ANTHROPIC_API_KEY=
# Optional per-agent keys, so the Anthropic Console shows and caps spend per agent.
# An agent without its own key falls back to ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY_ATLAS=
ANTHROPIC_API_KEY_MAGELLAN=
ANTHROPIC_API_KEY_ROSETTA=
ANTHROPIC_API_KEY_KNOX=
ANTHROPIC_API_KEY_DARWIN=
ANTHROPIC_API_KEY_HAMILTON=
# Optional model overrides for Hamilton research agents.
BFI_MODEL_CONSUMER=
BFI_MODEL_PRO=
BFI_MODEL_ADMIN=
# Optional: budget estimate per provider agent step, in micro-USD (default 100000).
PROVIDER_ESTIMATE_MICROUSD_PER_AGENT_STEP=

# ── Stripe (required for Pro checkout) ───────────────────────────────────────
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint for /api/webhooks/stripe; without it, paid
# checkouts never upgrade the account to Pro.
STRIPE_WEBHOOK_SECRET=
# The only prices checkout accepts (subscription mode): monthly and annual Pro.
STRIPE_PRO_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Report PDF bucket (src/lib/report-engine/presign.ts); defaults to bfi-reports.
R2_BUCKET=bfi-reports
# Source-document vault bucket (src/lib/agents/document-vault.ts); defaults to bank-fee-index-documents.
R2_DOCUMENTS_BUCKET=bank-fee-index-documents

# ── Transactional email (Resend, plain HTTPS; no SDK) ────────────────────────
# Without RESEND_API_KEY the app still stores leads/invites and reports email as
# not_configured.
RESEND_API_KEY=
# From address for all lead emails (report requests, contact, signup confirmations).
# Optional: falls back to WORKSPACE_INVITE_EMAIL_FROM, TRANSACTIONAL_EMAIL_FROM, EMAIL_FROM,
# then "Fee Insight <hello@bankfeeindex.com>". Its domain must be verified in Resend.
# /admin/leads shows the effective address and can send a test email.
REPORT_REQUEST_EMAIL_FROM="Fee Insight <hello@bankfeeindex.com>"
WORKSPACE_INVITE_EMAIL_FROM=

# Signs email-capture confirm/unsubscribe links (/email-preferences). Falls back to
# BFI_COOKIE_SECRET; without either, capture emails carry a reply-to-unsubscribe line only.
LEAD_EMAIL_TOKEN_SECRET=

# Optional MailerLite sync for confirmed capture leads (off unless "true" + API key).
# Leads sync on double-opt-in confirm and are marked unsubscribed on unsubscribe.
MAILERLITE_SYNC_ENABLED=false
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# Optional routed groups (Fee Insight account). Report leads, then institution/state
# watchers, go to these instead of MAILERLITE_GROUP_ID; unset falls back to it.
MAILERLITE_REPORT_GROUP_ID=
MAILERLITE_WATCHER_GROUP_ID=
# Optional MailerLite custom field key that receives the comma-separated lead sources.
MAILERLITE_SOURCE_FIELD=
# Hamilton's monthly marketing agent. The group its campaigns go to (falls back to
# MAILERLITE_GROUP_ID), and the postal address every marketing email must carry; sending
# is refused while the address is unset. MARKETING_WRITER_MODEL overrides the writer model.
MAILERLITE_MARKETING_GROUP_ID=
MARKETING_MAILING_ADDRESS=
MARKETING_WRITER_MODEL=
# Signing secret of the MailerLite webhook (subscriber.unsubscribed, bounced, spam_reported) that
# points at /api/webhooks/mailerlite; unsubscribes made in MailerLite are written back to leads.
MAILERLITE_WEBHOOK_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────────
# Both default to https://feeinsight.com.
NEXT_PUBLIC_SITE_URL=
BFI_APP_URL=

# ── Legacy (not needed) ──────────────────────────────────────────────────────
# Still accepted as cron secrets but superseded by CRON_SECRET; leave unset.
# BFI_REVALIDATE_TOKEN also guards /api/revalidate, which nothing calls.
# REPORT_CRON_SECRET=
# BFI_REVALIDATE_TOKEN=

# Node
NODE_ENV=production
