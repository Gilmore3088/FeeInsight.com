# Supabase Postgres
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Agentic execution
# disabled = create visible blocked run records only
# agentic_v1 = run the TypeScript agent ledger/workers
EXECUTION_BACKEND=disabled
AUTOMATION_CONTROL_ENABLED=false

# Cloudflare R2 (document store)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bank-fee-index-documents

# Authentication
BFI_ADMIN_PASSWORD=
BFI_ANALYST_PASSWORD=
BFI_COOKIE_SECRET=generate-a-random-64-char-hex-string

# Cache revalidation
BFI_APP_URL=https://feeinsight.com
BFI_REVALIDATE_TOKEN=generate-a-random-token

# AI providers
ANTHROPIC_API_KEY=

# External data APIs
FRED_API_KEY=

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=feeinsight.com

# Transactional email (Resend, plain HTTPS; no SDK). Without RESEND_API_KEY the
# app still stores leads/invites and reports email as not_configured.
RESEND_API_KEY=
# From address for report-request / contact notifications and auto-replies.
# Falls back to WORKSPACE_INVITE_EMAIL_FROM, then TRANSACTIONAL_EMAIL_FROM / EMAIL_FROM.
REPORT_REQUEST_EMAIL_FROM="Fee Insight <hello@bankfeeindex.com>"
WORKSPACE_INVITE_EMAIL_FROM=

# Signs email-capture confirm/unsubscribe links (/email-preferences). Falls back to
# BFI_COOKIE_SECRET; without either, capture emails carry a reply-to-unsubscribe line only.
LEAD_EMAIL_TOKEN_SECRET=

# Optional MailerLite sync for confirmed capture leads (off unless "true" + API key).
# Leads sync on double-opt-in confirm and are marked unsubscribed on unsubscribe.
MAILERLITE_SYNC_ENABLED=false
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
# Optional MailerLite custom field key that receives the comma-separated lead sources.
MAILERLITE_SOURCE_FIELD=

# Error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Internal report/API auth
REPORT_INTERNAL_SECRET=
REPORT_CRON_SECRET=

# Node
NODE_ENV=production
