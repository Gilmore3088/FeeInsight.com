 function fakeDb(live: LiveTakedownRow[]) {
   const writes: Array<{ text: string; values: unknown[] }> = [];
@@ -32,6 +38,7 @@ describe("hand takedowns (James, Oct 16)", () => {
       [102440, "source_mismatch: #1496"],
