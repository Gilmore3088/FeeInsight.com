{
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#f3efe6",
      "$description": "Page ground. Light: parchment; dark: Oxford Navy, the reverse ground every -reverse logo sits on. Also the box-plot I's median line.",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#f3efe6",
          "dark": "#132338"
        }
      }
    },
    "surface-0": {
      "$type": "color",
      "$value": "#fbf9f4",
      "$description": "Raised surfaces: cards, tables, inputs, chat bubbles.",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#fbf9f4",
          "dark": "#1a2c44"
        }
      }
    },
    "surface-200": {
      "$type": "color",
      "$value": "#ebe5d9",
      "$description": "Sunken areas: table header rows, filter bars, quiet button hover, code.",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#ebe5d9",
          "dark": "#0e1a2b"
        }
      }
    },
    "ink": {
      "$type": "color",
      "$value": "#132338",
      "$description": "Oxford Navy. Logo letters, ink tiles, headings and body copy. On paper, surface-0 and surface-200 (12.6:1+ both themes).",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#132338",
          "dark": "#f3efe6"
        }
      }
    },
    "on-ink": {
      "$type": "color",
      "$value": "#f3efe6",
      "$description": "Text on an ink fill (primary buttons, navy tiles).",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#f3efe6",
          "dark": "#132338"
        }
      }
    },
    "muted": {
      "$type": "color",
      "$value": "#55606f",
      "$description": "Pewter. The endorsement line (\"Powered by Fee Insight\"), captions, axis labels, metadata. On paper, surface-0 and surface-200 (5:1+ light, 6.6:1+ dark).",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#55606f",
          "dark": "#a9b3c1"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "#ddd5c6",
      "$description": "Hairlines: table rules, card outlines, dividers. Decorative only.",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#ddd5c6",
          "dark": "#263a55"
        }
      }
    },
    "control-border": {
      "$type": "color",
      "$value": "#767c87",
      "$description": "Input and secondary-button borders, chart whiskers (3:1+ on paper both themes). Not for text.",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#767c87",
          "dark": "#5d6f87"
        }
      }
    },
    "brick": {
      "$type": "color",
      "$value": "#b23a32",
      "$description": "Brick terracotta, the one accent. The box-plot I's box, the Bank Fee Index app tile, the subject bank in charts, focus rings, links, one accent button per view. Light #b23a32 is 5.2:1 on paper; dark #e0716a is 5.1:1 on navy. The navy app icons use the light-on-dark value #e0716a for their box.",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#b23a32",
          "dark": "#e0716a"
        }
      }
    },
    "on-brick": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Text on a brick fill (5.9:1 light, 5.1:1 dark).",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#ffffff",
          "dark": "#132338"
        }
      }
    },
    "brick-tint": {
      "$type": "color",
      "$value": "#f1d5d0",
      "$description": "Interquartile band in fee range charts; the accent tag fill; selected rows.",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#f1d5d0",
          "dark": "#4a2430"
        }
      }
    },
    "brick-ink": {
      "$type": "color",
      "$value": "#7f2620",
      "$description": "Text on brick-tint (6.9:1 light, 11.5:1 dark).",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#7f2620",
          "dark": "#f3efe6"
        }
      }
    },
    "above-market": {
      "$type": "color",
      "$value": "#b23a32",
      "$description": "Chart encoding: a fee above the market range. Always paired with a label or arrow.",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#b23a32",
          "dark": "#e0716a"
        }
      }
    },
    "in-range": {
      "$type": "color",
      "$value": "#5a646e",
      "$description": "Chart encoding: a fee inside the market range (5.2:1 light, 7:1 dark).",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#5a646e",
          "dark": "#a3adb8"
        }
      }
    },
    "below-market": {
      "$type": "color",
      "$value": "#3b6350",
      "$description": "Chart encoding: a fee below the market range, Sage Cypress (5.9:1 light, 6.8:1 dark). Differs from brick in lightness and hue; still label it.",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "#3b6350",
          "dark": "#7fb59b"
        }
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Icon-to-label gaps, tag padding."
    },
    "2": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Tight stacks; gap between the wordmark and its endorsement line at small sizes."
    },
    "3": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Control padding (vertical), table cell padding."
    },
    "4": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Default gap; control padding (horizontal); mobile page gutter."
    },
    "6": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Card padding."
    },
    "8": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Between related sections; desktop page gutter."
    },
    "12": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Between page sections."
    },
    "16": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "Hero padding; around the cover-sized logos."
    },
    "24": {
      "$type": "dimension",
      "$value": "96px",
      "$description": "Top-level marketing section rhythm."
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Tags, checkboxes, the box-plot box in charts."
    },
    "md": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Buttons, inputs, menus."
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Cards, panels, dialogs."
    },
    "tile": {
      "$type": "dimension",
      "$value": "22%",
      "$description": "App icon tiles (Fee Insight, Bank Fee Index, HI badge): 22% of the tile's side."
    }
  },
  "shadow": {
    "1": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(19,35,56,0.06), 0 0 0 1px rgba(19,35,56,0.06)",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "0 1px 2px rgba(19,35,56,0.06), 0 0 0 1px rgba(19,35,56,0.06)",
          "dark": "0 0 0 1px rgba(243,239,230,0.08)"
        }
      },
      "$description": "Cards that need lift on paper. Prefer a border hairline first."
    },
    "2": {
      "$type": "shadow",
      "$value": "0 8px 24px rgba(19,35,56,0.12), 0 0 0 1px rgba(19,35,56,0.06)",
      "$extensions": {
        "com.feeinsight.themes": {
          "light": "0 8px 24px rgba(19,35,56,0.12), 0 0 0 1px rgba(19,35,56,0.06)",
          "dark": "0 8px 24px rgba(5,10,18,0.55), 0 0 0 1px rgba(243,239,230,0.1)"
        }
      },
      "$description": "Menus, popovers, dialogs."
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Geist",
        "Helvetica Neue",
        "Arial",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Geist Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "64px",
        "lineHeight": "64px",
        "fontWeight": 800,
        "letterSpacing": "-0.03em"
      },
      "$description": "Hero headline, one per page. Heavy, tight, confident."
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "44px",
        "lineHeight": "48px",
        "fontWeight": 800,
        "letterSpacing": "-0.025em"
      },
      "$description": "Page titles."
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "30px",
        "lineHeight": "36px",
        "fontWeight": 700,
        "letterSpacing": "-0.02em"
      },
      "$description": "Section headings."
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 700,
        "letterSpacing": "-0.01em"
      },
      "$description": "Card and table titles."
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "18px",
        "lineHeight": "28px",
        "fontWeight": 400
      },
      "$description": "Lead paragraphs and marketing copy."
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "15px",
        "lineHeight": "24px",
        "fontWeight": 400
      },
      "$description": "Default UI and reading text."
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "13px",
        "lineHeight": "20px",
        "fontWeight": 400
      },
      "$description": "Captions, footnotes, table metadata."
    },
    "endorsement": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 500
      },
      "$description": "The endorsement line \"Powered by Fee Insight\" under Bank Fee Index and Hamilton: Geist Medium in muted, about a quarter of the wordmark's size."
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 600,
        "letterSpacing": "0.06em"
      },
      "$description": "Eyebrows, column headers, tags. Uppercase."
    },
    "figure-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "40px",
        "lineHeight": "44px",
        "fontWeight": 600,
        "letterSpacing": "-0.02em"
      },
      "$description": "Headline fee amounts in stat blocks."
    },
    "figure": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 500
      },
      "$description": "Fee amounts and percentages in tables and charts, right-aligned."
    }
  }
}